  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_FILE_PATHS\" | grep -qE 'ui/src/.*\\.(ts|html|scss|css|json)$'; then cd D:/code/elguerre/Taskin2.0/ui/src && npx prettier --write $CLAUDE_FILE_PATHS 2>/dev/null; fi",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_FILE_PATHS\" | grep -qE 'back/src/.*\\.cs$'; then cd D:/code/elguerre/Taskin2.0/back/src && dotnet format --include $CLAUDE_FILE_PATHS --verbosity quiet 2>/dev/null; fi",
            "timeout": 15000
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true
